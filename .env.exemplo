# Copy to .env and fill in. Never paste these values in a chat or commit them.
# Vertex AI route
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=your-gcp-location
# Authentication: choose ONE
# (a) ADC: run `gcloud auth application-default login` and leave the line below empty
# (b) Service account: path to the downloaded JSON key (keep it outside the repo)
GOOGLE_APPLICATION_CREDENTIALS=
# Optional fallback to the paid Gemini API (only with explicit authorization)
GEMINI_API_KEY=
